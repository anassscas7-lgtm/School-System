FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# Temporary diagnostics: prove which source Knoxverse is building
RUN echo "===== FRONTEND SOURCE CHECK =====" && \
    grep -n "DEFAULT_API_BASE_URL" src/utils/configureApiBase.js && \
    grep -n "configureApiBase" src/main.jsx

RUN npm run build


FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Temporary diagnostics: prove which nginx config is in the image
RUN echo "===== NGINX CONFIG CHECK =====" && \
    cat /etc/nginx/conf.d/default.conf && \
    nginx -t

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
